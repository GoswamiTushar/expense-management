MONGODB_URI=
DB_NAME=airbnb_expenses
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*

# Resend Transactional Email API (HTTPS Port 443)
RESEND_API_KEY=
EMAIL_FROM=

# Authentication (Generate 64-char random hex string)
JWT_SECRET=

# Admin Account Seed (Optional - keep empty if managing admin directly in DB)
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Web Push VAPID Keys (For OS lockscreen notifications when app/browser is closed)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:support@yourdomain.com
